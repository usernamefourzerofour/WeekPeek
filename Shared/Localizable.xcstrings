    "Open WeekPeek and allow calendar access": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح WeekPeek واسمح بالوصول إلى التقويمات"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете WeekPeek и разрешете достъп до календарите"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre WeekPeek i permet l’accés als calendaris"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete WeekPeek a povolte přístup ke kalendářům"
