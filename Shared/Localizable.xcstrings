        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekPeek følger språket på iPaden din. Du kan velge et annet språk for WeekPeek under Språk i Innstillinger. Det gjelder appen og alle widgeter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekPeek volgt de taal van je iPad. Je kunt een andere taal voor WeekPeek kiezen onder Taal in Instellingen. Die geldt voor de app en alle widgets."
