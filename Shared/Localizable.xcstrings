        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekPeek käyttää iPadisi kieltä. Voit valita WeekPeekille toisen kielen Asetusten kohdasta Kieli. Se koskee appia ja kaikkia widgetejä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekPeek suit la langue de votre iPad. Vous pouvez choisir une autre langue pour WeekPeek sous Langue dans Réglages. Elle s’applique à l’app et à tous les widgets."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekPeek משתמש בשפת ה‑iPad. אפשר לבחור שפה אחרת ל‑WeekPeek תחת ׳שפה׳ בהגדרות. היא חלה על היישום ועל כל הווידג׳טים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekPeek आपके iPad की भाषा का उपयोग करता है। आप सेटिंग्ज़ में भाषा के अंतर्गत WeekPeek के लिए दूसरी भाषा चुन सकते हैं। यह ऐप और सभी विजेट पर लागू होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekPeek prati jezik vašeg iPada. Drugi jezik za WeekPeek možete odabrati pod Jezik u Postavkama. Vrijedi za aplikaciju i sve widgete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A WeekPeek az iPad nyelvét követi. A Beállítások Nyelv menüjében másik nyelvet is választhatsz a WeekPeekhez. Ez az appra és az összes widgetre vonatkozik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekPeek mengikuti bahasa iPad Anda. Anda dapat memilih bahasa lain untuk WeekPeek di Bahasa dalam Pengaturan. Bahasa ini berlaku untuk app dan semua widget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekPeek segue la lingua del tuo iPad. Puoi scegliere un’altra lingua per WeekPeek in Lingua nelle Impostazioni. Vale per l’app e per tutti i widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekPeekはiPadの言語に従います。設定の「言語」でWeekPeek用に別の言語を選べます。Appとすべてのウィジェットに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekPeek은 iPad의 언어를 따릅니다. 설정의 언어에서 WeekPeek에 다른 언어를 선택할 수 있습니다. 앱과 모든 위젯에 적용됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekPeek naudoja jūsų iPad kalbą. Kitą WeekPeek kalbą galite pasirinkti Nustatymų skiltyje Kalba. Ji taikoma programai ir visiems valdikliams."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekPeek mengikut bahasa iPad anda. Anda boleh memilih bahasa lain untuk WeekPeek di bawah Bahasa dalam Seting. Ia digunakan untuk app dan semua widget."
