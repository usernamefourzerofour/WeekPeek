    "Touch and hold the widget › Edit Widget to choose days, columns, text size, colors and more.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس الأداة مطولًا › تعديل الأداة لاختيار الأيام والأعمدة وحجم النص والألوان والمزيد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задръжте върху уиджета › Редактиране на уиджета, за да изберете дни, колони, размер на текста, цветове и др."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén premut el widget › Editar el widget per triar dies, columnes, mida del text, colors i més."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte prst na widgetu › Upravit widget a vyberte dny, sloupce, velikost textu, barvy a další."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk og hold på widgetten › Rediger widget for at vælge dage, søjler, tekststørrelse, farver og meget mere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege den Finger auf das Widget › Widget bearbeiten, um Tage, Spalten, Textgröße, Farben und mehr zu wählen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε παρατεταμένα το widget › Επεξεργασία widget για ημέρες, στήλες, μέγεθος κειμένου, χρώματα και άλλα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el widget › Editar widget para elegir días, columnas, tamaño del texto, colores y más."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionado el widget › Editar widget para elegir días, columnas, tamaño del texto, colores y más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä sormea widgetin päällä › Muokkaa widgetiä ja valitse päivät, sarakkeet, tekstin koko, värit ja muuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez longuement le widget › Modifier le widget pour choisir les jours, les colonnes, la taille du texte, les couleurs et plus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "געו והחזיקו בווידג׳ט › עריכת ווידג׳ט כדי לבחור ימים, עמודות, גודל טקסט, צבעים ועוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन, कॉलम, टेक्स्ट का आकार, रंग आदि चुनने के लिए विजेट को स्पर्श करके रखें › विजेट संपादित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite i držite widget › Uredi widget za odabir dana, stupaca, veličine teksta, boja i više."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd az ujjad a widgeten › Widget szerkesztése, és válaszd ki a napokat, oszlopokat, szövegméretet, színeket és egyebeket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentuh dan tahan widget › Edit Widget untuk memilih hari, kolom, ukuran teks, warna, dan lainnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e tieni premuto il widget › Modifica widget per scegliere giorni, colonne, dimensione del testo, colori e altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットを長押し › ウィジェットを編集で、日数、列、文字サイズ、色などを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯을 길게 누르기 › 위젯 편집에서 일수, 열, 텍스트 크기, 색상 등을 선택하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaikykite valdiklį › Redaguoti valdiklį ir pasirinkite dienas, stulpelius, teksto dydį, spalvas ir kt."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentuh dan tahan widget › Edit Widget untuk memilih hari, lajur, saiz teks, warna dan banyak lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold fingeren på widgeten › Rediger widget for å velge dager, kolonner, tekststørrelse, farger og mer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je vinger op de widget › Wijzig widget om dagen, kolommen, tekstgrootte, kleuren en meer te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij i przytrzymaj widżet › Edytuj widżet, aby wybrać dni, kolumny, rozmiar tekstu, kolory i więcej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e mantenha pressionado o widget › Editar Widget para escolher dias, colunas, tamanho do texto, cores e mais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha premido o widget › Editar widget para escolher dias, colunas, tamanho do texto, cores e mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge lung widgetul › Editează widgetul pentru a alege zilele, coloanele, mărimea textului, culorile și altele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь виджета и удерживайте › Изменить виджет, чтобы выбрать дни, столбцы, размер текста, цвета и другое."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte prst na widgete › Upraviť widget a vyberte dni, stĺpce, veľkosť textu, farby a ďalšie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridržite pripomoček › Uredi pripomoček, da izberete dneve, stolpce, velikost besedila, barve in drugo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll fingret på widgeten › Redigera widget för att välja dagar, kolumner, textstorlek, färger och mer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะวิดเจ็ตค้างไว้ › แก้ไขวิดเจ็ต เพื่อเลือกวัน คอลัมน์ ขนาดข้อความ สี และอื่นๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günleri, sütunları, metin boyutunu, renkleri ve daha fazlasını seçmek için widget’a basılı tutun › Widget’ı düzenle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться й утримуйте віджет › Редагувати віджет, щоб вибрати дні, стовпці, розмір тексту, кольори тощо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm và giữ tiện ích › Sửa tiện ích để chọn số ngày, cột, cỡ chữ, màu sắc và hơn thế nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住小组件 › 编辑小组件，选择天数、列数、文字大小、颜色等。"
