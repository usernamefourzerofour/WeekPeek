        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekPeek использует язык iPad. Другой язык для WeekPeek можно выбрать в разделе «Язык» в Настройках. Он действует для приложения и всех виджетов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekPeek používa jazyk vášho iPadu. Iný jazyk pre WeekPeek môžete vybrať v Nastaveniach v časti Jazyk. Platí pre aplikáciu aj všetky widgety."
          }
        },
        "sl": {
          "stringUnit": {
