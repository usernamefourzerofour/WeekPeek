    "Your upcoming events at a glance. Tap a day to open your calendar app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحداثك القادمة بنظرة واحدة. اضغط على يوم لفتح تطبيق التقويم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Предстоящите ви събития с един поглед. Докоснете ден, за да отворите календарното приложение."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els teus propers esdeveniments d’un cop d’ull. Toca un dia per obrir la teva app de calendari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadcházející události na první pohled. Klepnutím na den otevřete kalendářovou aplikaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine kommende aftaler med et blik. Tryk på en dag for at åbne din kalenderapp."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine nächsten Termine auf einen Blick. Tippe auf einen Tag, um deine Kalender-App zu öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα επόμενα συμβάντα σας με μια ματιά. Αγγίξτε μια ημέρα για να ανοίξει η εφαρμογή ημερολογίου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus próximos eventos de un vistazo. Toca un día para abrir tu app de calendario."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus próximos eventos de un vistazo. Toca un día para abrir tu app de calendario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulevat tapahtumasi yhdellä silmäyksellä. Avaa kalenteriappisi napauttamalla päivää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos prochains événements en un coup d’œil. Touchez un jour pour ouvrir votre app de calendrier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האירועים הקרובים שלך במבט אחד. הקישו על יום כדי לפתוח את יישום לוח השנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके आगामी इवेंट एक नज़र में। कैलेंडर ऐप खोलने के लिए किसी दिन पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši nadolazeći događaji na prvi pogled. Dodirnite dan za otvaranje aplikacije kalendara."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő eseményeid egy pillantással. Koppints egy napra a naptár app megnyitásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Acara mendatang Anda dalam sekilas. Ketuk hari untuk membuka app kalender."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi prossimi eventi a colpo d’occhio. Tocca un giorno per aprire la tua app calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後の予定をひと目で確認。日付をタップするとカレンダーAppが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다가오는 일정을 한눈에. 날짜를 탭하면 캘린더 앱이 열립니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Artimiausi įvykiai vienu žvilgsniu. Bakstelėkite dieną, kad atidarytumėte kalendoriaus programą."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Acara akan datang anda sepintas lalu. Ketik hari untuk membuka app kalendar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De neste hendelsene dine med ett blikk. Trykk på en dag for å åpne kalenderappen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je komende activiteiten in één oogopslag. Tik op een dag om je agenda-app te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadchodzące wydarzenia w skrócie. Stuknij dzień, aby otworzyć aplikację kalendarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus próximos eventos num relance. Toque em um dia para abrir seu app de calendário."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus próximos eventos num relance. Toque num dia para abrir a sua app de calendário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evenimentele tale următoare dintr-o privire. Atinge o zi pentru a deschide app-ul de calendar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ближайшие события одним взглядом. Коснитесь дня, чтобы открыть приложение календаря."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadchádzajúce udalosti na prvý pohľad. Klepnutím na deň otvoríte kalendárovú aplikáciu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihajajoči dogodki na prvi pogled. Tapnite dan, da odprete aplikacijo za koledar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina kommande händelser i en blick. Tryck på en dag för att öppna din kalenderapp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูกิจกรรมที่กำลังจะมาถึงได้ในพริบตา แตะวันเพื่อเปิดแอปปฏิทิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşan etkinlikleriniz bir bakışta. Takvim uygulamanızı açmak için bir güne dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найближчі події з першого погляду. Торкніться дня, щоб відкрити програму календаря."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem nhanh các sự kiện sắp tới. Chạm vào một ngày để mở ứng dụng lịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看到即将到来的日程。轻点某一天即可打开日历 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看到即將到來的行程。點一下某一天即可打開行事曆 App。"
          }
        }
      }
    }
  }
