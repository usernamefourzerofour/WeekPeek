{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ could not be opened. Is the app installed?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح %@. هل التطبيق مثبّت؟"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не може да се отвори. Инсталирано ли е приложението?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut obrir %@. L’app està instal·lada?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nelze otevřít. Je aplikace nainstalovaná?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kunne ikke åbnes. Er appen installeret?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht geöffnet werden. Ist die App installiert?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατό το άνοιγμα του %@. Είναι εγκατεστημένη η εφαρμογή;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir %@. ¿Está instalada la app?"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir %@. ¿Está instalada la app?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohdetta %@ ei voitu avata. Onko app asennettu?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir %@. L’app est-elle installée ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לפתוח את %@. האם היישום מותקן?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ नहीं खुल सका। क्या ऐप इंस्टॉल है?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nije moguće otvoriti. Je li aplikacija instalirana?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nem nyitható meg. Telepítve van az app?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak dapat dibuka. Apakah app sudah diinstal?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire %@. L’app è installata?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を開けませんでした。Appはインストールされていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 열 수 없습니다. 앱이 설치되어 있나요?"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko atidaryti %@. Ar programa įdiegta?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak dapat dibuka. Adakah app dipasang?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke åpne %@. Er appen installert?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan niet worden geopend. Is de app geïnstalleerd?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można otworzyć %@. Czy aplikacja jest zainstalowana?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir %@. O app está instalado?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir %@. A app está instalada?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu a putut fi deschis. Este instalat app-ul?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть %@. Приложение установлено?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sa nedá otvoriť. Je aplikácia nainštalovaná?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ni mogoče odpreti. Ali je aplikacija nameščena?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kunde inte öppnas. Är appen installerad?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเปิด %@ ได้ ติดตั้งแอปแล้วหรือยัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ açılamadı. Uygulama yüklü mü?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити %@. Програму встановлено?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể mở %@. Ứng dụng đã được cài đặt chưa?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开 %@。是否已安装该 App？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法打開 %@。是否已安裝此 App？"
          }
        }
      }
    },
