        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekPeek używa języka Twojego iPada. W Ustawieniach, w sekcji Język, możesz wybrać inny język dla WeekPeek. Dotyczy on aplikacji i wszystkich widżetów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O WeekPeek segue o idioma do seu iPad. Você pode escolher outro idioma para o WeekPeek em Idioma nos Ajustes. Ele vale para o app e todos os widgets."
          }
        },
        "pt-PT": {
          "stringUnit": {
