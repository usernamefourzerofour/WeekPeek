    "Choose Google or Microsoft Exchange, sign in and turn on Calendars. Your events stay on your iPad.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر Google أو Microsoft Exchange وسجّل الدخول وشغّل التقويمات. تبقى أحداثك على iPad."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете Google или Microsoft Exchange, влезте и включете „Календари“. Вашите събития остават на iPad."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria Google o Microsoft Exchange, inicia la sessió i activa Calendaris. Els teus esdeveniments es queden a l’iPad."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte Google nebo Microsoft Exchange, přihlaste se a zapněte Kalendáře. Vaše události zůstanou v iPadu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg Google eller Microsoft Exchange, log ind, og slå Kalendere til. Dine begivenheder bliver på din iPad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Google oder Microsoft Exchange, melde dich an und aktiviere Kalender. Deine Ereignisse bleiben auf deinem iPad."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε Google ή Microsoft Exchange, συνδεθείτε και ενεργοποιήστε τα Ημερολόγια. Τα συμβάντα σας μένουν στο iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Google o Microsoft Exchange, inicia sesión y activa Calendarios. Tus eventos se quedan en tu iPad."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Google o Microsoft Exchange, inicia sesión y activa Calendarios. Tus eventos se quedan en tu iPad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse Google tai Microsoft Exchange, kirjaudu sisään ja laita Kalenterit päälle. Tapahtumasi pysyvät iPadissasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Google ou Microsoft Exchange, connectez-vous et activez Calendriers. Vos événements restent sur votre iPad."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו ב‑Google או ב‑Microsoft Exchange, התחברו והפעילו את לוחות השנה. האירועים שלכם נשארים ב‑iPad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google या Microsoft Exchange चुनें, साइन इन करें और कैलेंडर चालू करें। आपके इवेंट आपके iPad पर ही रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite Google ili Microsoft Exchange, prijavite se i uključite Kalendare. Vaši događaji ostaju na iPadu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd a Google-t vagy a Microsoft Exchange-et, jelentkezz be, és kapcsold be a Naptárakat. Az eseményeid az iPaden maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Google atau Microsoft Exchange, masuk, lalu nyalakan Kalender. Acara Anda tetap di iPad Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Google o Microsoft Exchange, accedi e attiva Calendari. I tuoi eventi restano su iPad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GoogleまたはMicrosoft Exchangeを選んでサインインし、「カレンダー」をオンにします。予定はiPadの中にとどまります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 또는 Microsoft Exchange를 선택하고 로그인한 다음 캘린더를 켜십시오. 이벤트는 iPad에 그대로 남습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite „Google“ arba „Microsoft Exchange“, prisijunkite ir įjunkite Kalendorius. Jūsų įvykiai lieka „iPad“."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Google atau Microsoft Exchange, daftar masuk dan aktifkan Kalendar. Acara anda kekal pada iPad anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg Google eller Microsoft Exchange, logg på og slå på Kalendere. Hendelsene dine blir værende på iPaden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies Google of Microsoft Exchange, log in en zet Agenda's aan. Je activiteiten blijven op je iPad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz Google lub Microsoft Exchange, zaloguj się i włącz Kalendarze. Twoje wydarzenia pozostają na iPadzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Google ou Microsoft Exchange, inicie a sessão e ative Calendários. Seus eventos ficam no iPad."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Google ou Microsoft Exchange, inicie sessão e ative Calendários. Os seus eventos ficam no iPad."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege Google sau Microsoft Exchange, autentifică-te și activează Calendare. Evenimentele tale rămân pe iPad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите Google или Microsoft Exchange, войдите и включите «Календари». Ваши события остаются на iPad."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte Google alebo Microsoft Exchange, prihláste sa a zapnite Kalendáre. Vaše udalosti zostanú v iPade."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite Google ali Microsoft Exchange, se prijavite in vklopite Koledarje. Vaši dogodki ostanejo v iPadu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj Google eller Microsoft Exchange, logga in och aktivera Kalendrar. Dina händelser stannar på din iPad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก Google หรือ Microsoft Exchange ลงชื่อเข้าใช้ แล้วเปิดปฏิทิน กิจกรรมของคุณจะอยู่บน iPad ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google’ı veya Microsoft Exchange’i seçin, giriş yapın ve Takvimler’i açın. Etkinlikleriniz iPad’inizde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть Google або Microsoft Exchange, увійдіть і ввімкніть «Календарі». Ваші події залишаються на iPad."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn Google hoặc Microsoft Exchange, đăng nhập và bật Lịch. Sự kiện của bạn vẫn ở trên iPad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Google 或 Microsoft Exchange，登录并打开“日历”。你的日程会留在 iPad 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 Google 或 Microsoft Exchange，登入並開啟「行事曆」。你的行程會留在 iPad 上。"
          }
        }
      }
    },
