        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e tieni premuto sulla schermata Home › Modifica › Aggiungi widget › WeekPeek. Scegli piccolo, medio o grande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面を長押し › 編集 › ウィジェットを追加 › WeekPeek。小・中・大から選びます。"
