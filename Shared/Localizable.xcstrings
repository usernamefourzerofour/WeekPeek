    "No full access. Turn it on in Settings › Apps › WeekPeek.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد وصول كامل. شغّله من الإعدادات › التطبيقات › WeekPeek."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
